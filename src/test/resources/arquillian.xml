<?xml version="1.0"?>

<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <engine>
        <property name="deploymentExportPath">target/</property>
    </engine>
    <container qualifier="payara">
        <configuration>
            <!-- <property name="outputToConsole">true</property> -->
            <property name="adminUser">admin</property>
            <property name="adminPassword"></property>
        </configuration>
    </container>
    <container qualifier="openliberty" default="true">
        <configuration>
            <property name="allowConnectingToRunningServer">true</property>
            <property name="wlpHome">target/liberty/wlp</property>
            <property name="serverName">defaultServer</property>
            <property name="httpPort">8080</property>
            <property name="deployType">xml</property>
            <property name="sharedLib">DerbyLib</property>
        </configuration>
    </container>
</arquillian>
